.DS_Store
.env
# Secrets auf dem Server, angelegt von scripts/push-secrets.sh
secrets/
tofu/.terraform/
tofu/*.tfstate.backup
tofu/keys/*
!tofu/keys/*.pub
tofu/*.tfplan
# Previews des Blogs: Inhalte und Caddy-Einträge legt deploy.sh auf dem Server an
previews/*
!previews/.gitkeep
caddy/previews/*
!caddy/previews/.gitkeep
