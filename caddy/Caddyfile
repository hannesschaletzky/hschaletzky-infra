# Öffentlicher Einstiegspunkt: TLS (Let's Encrypt), HTTP/3, Weiterleitungen.
{
	email info@hschaletzky.com
}

(standard) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log {
		output file /var/log/caddy/access.log {
			roll_size 20MiB
			roll_keep_for 336h
		}
	}
}

# Sicherheits-Header für Apps, die sie nicht selbst setzen. Die statischen Seiten (eigene
# deploy/Caddyfile) und hschaletzky-auth setzen ihre eigenen. Keine Skript-CSP: die bräuchte jede App
# einzeln; hier nur, was nie stört (kein Einbetten in fremde Seiten, kein MIME-Raten).
(sicherheit) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
	}
}

# Obergrenze für Anfrage-Bodies bei Apps mit offener Schreib-API (ohne Login): Ein einzelner
# Request kann so nicht die Platte füllen, die sich alle Dienste teilen. Zu groß → 413.
(kleine_bodies) {
	request_body {
		max_size 100KB
	}
}

hschaletzky.com {
	import standard
	import sicherheit
	# Zählskript und Ereignisse von Plausible über die eigene Domain, so lädt der Browser nichts von Dritten
	@plausible path /js/script.* /js/pa-* /api/event
	handle @plausible {
		reverse_proxy plausible:8000
	}
	reverse_proxy hschaletzky:3000
}

# Server-Monitoring (Beszel), Login nur für mich
monitor.hschaletzky.com {
	import standard
	reverse_proxy beszel:8090
}

# Besucherstatistik (Plausible), Login nur für mich
stats.hschaletzky.com {
	import standard
	reverse_proxy plausible:8000
}

www.hschaletzky.com {
	redir https://hschaletzky.com{uri} permanent
}

tischlerei-mustermann.hschaletzky.com {
	import standard
	# Erfundener Beispielbetrieb: aus der Google-Suche heraushalten, aber crawlbar lassen (sonst sieht Google
	# das noindex nie). Kein nofollow: Links zu hschaletzky.com (Impressum, Demo-Leiste) sollen zählen.
	header X-Robots-Tag "noindex"
	@plausible path /js/pa-* /api/event
	handle @plausible {
		reverse_proxy plausible:8000
	}
	reverse_proxy tischlerei:80
}

# Mängelfassung für den Beispielbericht des Website-Check-ups: bewusst ohne HSTS, sonst wie „standard“
vorher.tischlerei-mustermann.hschaletzky.com {
	encode zstd gzip
	header -Server
	log {
		output file /var/log/caddy/access.log {
			roll_size 20MiB
			roll_keep_for 336h
		}
	}
	reverse_proxy tischlerei-maengel:80
}

